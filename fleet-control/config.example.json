      "token_env": "GH_TOKEN_ACCT_04",
      "repos": ["YOUR_GITHUB_USER_4/rdp-lxde"],
      "machines_per_account": 8
    },
    {
      "name": "acct-05",
      "enabled": false,
      "gh_user": "YOUR_GITHUB_USER_5",
      "token_env": "GH_TOKEN_ACCT_05",
      "repos": ["YOUR_GITHUB_USER_5/rdp-lxde"],
      "machines_per_account": 8
    },
    {
      "name": "acct-06",
      "enabled": false,
      "gh_user": "YOUR_GITHUB_USER_6",
      "token_env": "GH_TOKEN_ACCT_06",
      "repos": ["YOUR_GITHUB_USER_6/rdp-lxde"],
      "machines_per_account": 8
    },
    {
      "name": "acct-07",
      "enabled": false,
      "gh_user": "YOUR_GITHUB_USER_7",
      "token_env": "GH_TOKEN_ACCT_07",
