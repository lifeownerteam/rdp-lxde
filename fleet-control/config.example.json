{
  "agent_port": 8765,
  "machines_per_account": 8,
  "target_total": 80,
  "max_concurrent_dispatch_per_account": 8,
  "workflow_id": "rdp-alpine-openbox.yml",
  "workflow_name": "RDP Linux Desktop (LXDE)",
  "poll_interval_seconds": 30,
  "accounts": [
    {
      "name": "acct-01",
      "enabled": true,
      "gh_user": "YOUR_GITHUB_USER_1",
      "token_env": "GH_TOKEN_ACCT_01",
      "gh_host": "github.com",
      "repos": ["YOUR_GITHUB_USER_1/rdp-lxde"],
      "machines_per_account": 8
    },
    {
      "name": "acct-02",
      "enabled": false,
      "gh_user": "YOUR_GITHUB_USER_2",
      "token_env": "GH_TOKEN_ACCT_02",
      "repos": ["YOUR_GITHUB_USER_2/rdp-lxde"],
      "machines_per_account": 8
    },
    {
      "name": "acct-03",
      "enabled": false,
      "gh_user": "YOUR_GITHUB_USER_3",
      "token_env": "GH_TOKEN_ACCT_03",
      "repos": ["YOUR_GITHUB_USER_3/rdp-lxde"],
      "machines_per_account": 8
    },
    {
      "name": "acct-04",
      "enabled": false,
