      "machines_per_account": 8
    }
  ],
  "tailscale": {
    "api_keys": [
      {
        "name": "main-tailnet",
        "key_env": "TS_API_KEY_MAIN",
        "tailnet": "-"
      }
    ],
    "note": "Optional: use Tailscale API to list devices and correlate hostnames gh-runner-*"
  },
  "fleet_agent_token_env": "FLEET_AGENT_TOKEN",
  "fleet_agent_token": "change-me-use-long-random-string",
  "state_file": "fleet-state.json",
  "dashboard": {
    "bind": "127.0.0.1",
    "port": 8780
  },
  "fleet_note": "80 machines ≈ 10 enabled accounts × 8. GHA free tier ~20 concurrent jobs/account; dispatch all accounts quickly, IPs trickle in 15–25 min."
}
